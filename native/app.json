{
  "expo": {
    "name": "سند جايك",
    "slug": "sanad-jaik",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "sanadjaik",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.sanadjaik.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك لعرض أقرب كرين لسيارتك وإرسال طلبك للسائقين القريبين."
      }
    },
    "android": {
      "package": "com.sanadjaik.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101214",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك لعرض أقرب كرين لسيارتك وإرسال طلبك للسائقين القريبين."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supabaseUrl": "https://hwlpzlfimplzkdleaclw.supabase.co"
    }
  }
}